APP_NAME=RelayForge
APP_VERSION=0.2.0
ENVIRONMENT=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://relayforge:relayforge@postgres:5432/relayforge

ALPHA_BASE_URL=http://mock-provider:9000
ALPHA_CLIENT_ID=relayforge
ALPHA_CLIENT_SECRET=replace-with-a-secret
ALPHA_TIMEOUT_SECONDS=5

BETA_BASE_URL=http://mock-provider:9000
BETA_API_KEY=replace-with-an-api-key
BETA_TIMEOUT_SECONDS=5

PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.25
